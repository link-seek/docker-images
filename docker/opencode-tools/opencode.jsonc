{
  "$schema": "https://opencode.ai/config.json",
  "permission": "allow",
  "model": "opencode-go/muse-spark-1.3-contributor",
  // 压不住的教训（#103）：单次 843K、累计 15M 都没触发过 compaction（time_compacting=null），
  // 模型退化吐空参连败 17 次。auto 默认开但阈值按网关上报 window 算，muse-spark 的 limit 继承链是断的，
  // 所以 buffer 从默认 15% 加到 30% 让它早压；keep.tokens 从 15000 降到 10000。
  // 验收：跑长会话后查 session_v2.time_compacting 非空即生效。
  "compaction": {
    "auto": true,
    "keep": { "tokens": 10000 },
    "buffer": "30%"
  },
  // 常态记忆 L2：opencode-mem 向量插件（pin 死版本，autoUpdate 在 opencode-mem.jsonc 里关；
  // 插件版本单源头：只看 Dockerfile 的 ARG OPENCODE_MEM_VERSION（构建时 sed 注入下行占位符，
  // 本文件不手写版本号）；版本前移只走 digest pin 流程，不接受 floating。
  "plugins": ["opencode-mem@__OPENCODE_MEM_VERSION__"],
  // 设计 MCP（feimacode/open-design-agent-kit-mcp，不烘焙，npx 随调随下；
  // 2.1.4 实测：timeout 必须是完整对象（含 catalog），缺键整段 mcp 被静默丢弃；
  // 数字也行（会展开成三键同值），但对象保留 startup<execution 的分级意图）。
  // npx 首启要下载（startup 给足），生成类工具跑得久（execution 给足）；密钥不进镜像（模型走网关，MCP server 本身不调模型）。
  "mcp": {
    "servers": {
      "open-design": {
        "type": "local",
        "command": ["npx", "-y", "@feimacode/open-design-agent-kit-mcp"],
        "timeout": {
          "startup": 120000,
          "catalog": 180000,
          "execution": 600000
        }
      }
    }
  },
  "provider": {
    "opencode-go": {
      "options": {
        "baseURL": "{env:LITELLM_BASE_URL}",
        "apiKey": "{env:LITELLM_API_KEY}"
      }
    }
  }
}

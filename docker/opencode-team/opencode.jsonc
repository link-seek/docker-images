{
  "$schema": "https://opencode.ai/config.json",
  "permission": "allow",
  "model": "huawei-maas/deepseek-v4.1-flash-1017",
  // team 只用华为 MAAS：白名单隐藏其他供应商（未配 key 的排前面问题），默认即 1017。
  "enabled_providers": ["huawei-maas"],
  // 常态记忆 L2：opencode-mem 向量插件（pin 死版本，autoUpdate 在 opencode-mem.jsonc 里关；
  // 插件版本单源头：只看 Dockerfile 的 ARG OPENCODE_MEM_VERSION（构建时 sed 注入下行占位符，
  // 本文件不手写版本号）；版本前移只走 digest pin 流程，不接受 floating。
  "plugins": ["opencode-mem@__OPENCODE_MEM_VERSION__"],
  // 设计 MCP（feimacode/open-design-agent-kit-mcp，烘焙进镜像走本地二进制直调；
  // 2.1.4 实测：timeout 必须是完整对象（含 catalog），缺键整段 mcp 被静默丢弃；
  // 数字也行（会展开成三键同值），但对象保留 startup<execution 的分级意图）。
  // 版本见 Dockerfile ARG OD_MCP_VERSION；本地二进制无下载等待（startup 照给，防冷机慢），生成类工具跑得久（execution 给足）；密钥不进镜像（模型走网关，MCP server 本身不调模型）。
  "mcp": {
    "servers": {
      "open-design": {
        "type": "local",
        "command": ["open-design-mcp"],
        "timeout": {
          "startup": 120000,
          "catalog": 180000,
          "execution": 600000
        }
      },
      // 组织记忆 trial：cognee 集中式（ClusterIP 集群内直达，无鉴权；隔离靠 dataset 约定）。
      // team 只用 trial-team（私库）+ org-settled（共享）。烘焙进镜像，避免运行期改写只读的 /root/.config。
      "cognee": {
        "type": "remote",
        "url": "http://cognee.cognee-trial.svc.cluster.local:8000/mcp",
        "oauth": false,
        "timeout": {
          "startup": 45000,
          "catalog": 60000,
          "execution": 600000
        }
      }
    }
  },
  // team 直连华为云 MAAS（models.dev 内置 huawei-maas，baseURL 内建，只需 apiKey）。
  // LITELLM_* 保留给网关（本 team 不再用 opencode-go）。
  "provider": {
    "huawei-maas": {
      "options": {
        "apiKey": "{env:MAAS_KEY}"
      }
    }
  }
}

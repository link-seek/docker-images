{
  "$schema": "https://opencode.ai/config.json",
  "permission": "allow",
  "model": "huawei-maas/deepseek-v4.1-flash-1017",
  // team 只用华为 MAAS：白名单隐藏其他供应商（未配 key 的排前面问题），默认即 1017。
  "enabled_providers": ["huawei-maas"],
  // 长期记忆：opencode-cognee 文件插件（/.opencode/plugins/cognee/，目录扫描加载；
  // 版本单源头：Dockerfile 的 ARG OPENCODE_COGNEE_VERSION；opencode-mem 已于 2026-11-27 下线）。
  "plugins": [],
  // 设计 MCP（feimacode/open-design-agent-kit-mcp，烘焙进镜像走本地二进制直调；
  // 2.1.4 实测：timeout 必须是完整对象（含 catalog），缺键整段 mcp 被静默丢弃；
  // 数字也行（会展开成三键同值），但对象保留 startup<execution 的分级意图）。
  // 版本见 Dockerfile 的 odk-builder ARG ODK_REF（从 git main 构建，含远程浏览器 PR #114）；本地二进制无下载等待（startup 照给，防冷机慢），生成类工具跑得久（execution 给足）；密钥不进镜像（模型走网关，MCP server 本身不调模型）。
  "mcp": {
    "servers": {
      "open-design": {
        "type": "local",
        "command": ["open-design-mcp"],
        "timeout": {
          "startup": 120000,
          "catalog": 180000,
          "execution": 600000
        }
      }
    }
  },
  // team 直连华为云 MAAS（models.dev 内置 huawei-maas，baseURL 内建，只需 apiKey）。
  // LITELLM_* 保留给网关（本 team 不再用 opencode-go）。
  "provider": {
    "huawei-maas": {
      "options": {
        "apiKey": "{env:MAAS_KEY}"
      }
    }
  }
}

# litellm-gateway：上游 litellm 官方镜像 + 本仓 guard/配置 bake 进去，开箱即用。
# 用法：docker build -f Dockerfile.litellm-gateway -t <镜像> .
# 背景：之前 guard-*.py/config.yaml 靠 compose volume 挂载，部署仓和测试各维护一份影子配置，
# 行为漂移无人发现（passthrough callback 未加载事故，2026-10-17）。bake 进镜像后行为=digest，CI 拉 digest 测的就是将要上线的字节。
# 版本 pin（digest）：升级 = 改这行发 PR（跟 opencode-tools 的 pin 机制一致，禁止 tag）。
# 上游 GHCR 无版本 tag（只有 latest），必须 digest pin；当前值与生产网关运行 digest 一致。
FROM ghcr.io/berriai/litellm@sha256:3def0387871a732a6d18b009576c4bf4313c54d448fa938a58f51cf189d1fa33

USER root

# guard + 配置 bake 进 /app（与生产 compose 挂载路径一致，行为一致）：
# config/litellm_config.yaml（透明代理：custom_auth 全放行＋passthrough callback；官方键名 custom_auth，user_custom_auth 无人读取）
# guard/*.py + guard/*.json（vault guard 黑名单规则）
COPY litellm-gateway/config/litellm_config.yaml /app/config.yaml
COPY litellm-gateway/guard/ /app/
COPY litellm-gateway/healthcheck /app/healthcheck
# 启动校验：config 合法 + guard 模块可 import（构建期拦住，不是运行时炸）
RUN python3 -c "import yaml; d=yaml.safe_load(open('/app/config.yaml')); print('models:', len(d['model_list'])); assert 'callbacks' in d.get('litellm_settings', {}); g=d.get('general_settings', {}); assert g.get('custom_auth')=='always_allow_auth.always_allow', 'custom_auth hook 缺失'; assert 'user_custom_auth' not in g, 'user_custom_auth 是无人读取的错键名'" \
 && python3 -c "import ast; [ast.parse(open(f'/app/{m}.py').read()) for m in ('always_allow_auth','passthrough_key','vault_guard')]; print('guard syntax OK')" \
 && python3 -c "import sys; sys.path.insert(0, '/app'); from litellm.proxy.auth.user_api_key_auth import UserAPIKeyAuth; src=open('/app/always_allow_auth.py').read(); assert '\"INTERNAL_USER\"' not in src and \"'INTERNAL_USER'\" not in src, 'user_role 必须小写 internal_user'; UserAPIKeyAuth(api_key='ci-probe', user_role='internal_user'); print('auth role OK（枚举校验过）')"
# 固定函数契约在位：实现随镜像（存在、可执行、语法过、denied 数据同目录），部署线盲调
RUN chmod +x /app/healthcheck \
 && bash -n /app/healthcheck \
 && test -f /app/models-denied.json \
 && echo 'healthcheck OK（--base-url/--api-key/--level，exit 0=可用）'

# tailscale：官方静态二进制（与 opencode-tools 同版本 pin；网关容器 userspace 入网用，无需 tun/NET_ADMIN）
ARG TAILSCALE_VERSION=1.102.4
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl \
 && rm -rf /var/lib/apt/lists/* \
 && ARCH="$(uname -m)"; case "$ARCH" in x86_64) TS_ARCH=amd64;; aarch64) TS_ARCH=arm64;; *) echo "unsupported arch $ARCH" && exit 1;; esac \
 && curl -fsSL -o /tmp/tailscale.tgz \
      "https://pkgs.tailscale.com/stable/tailscale_${TAILSCALE_VERSION}_${TS_ARCH}.tgz" \
 && tar -xzf /tmp/tailscale.tgz -C /tmp \
 && mv "/tmp/tailscale_${TAILSCALE_VERSION}_${TS_ARCH}/tailscale" /usr/local/bin/tailscale \
 && mv "/tmp/tailscale_${TAILSCALE_VERSION}_${TS_ARCH}/tailscaled" /usr/local/bin/tailscaled \
 && rm -rf /tmp/tailscale.tgz "/tmp/tailscale_${TAILSCALE_VERSION}_${TS_ARCH}" \
 && tailscale version

WORKDIR /app
EXPOSE 4000
# 默认命令与生产 compose 一致（deploy 侧可覆盖）；master key 只走 env 不进镜像
CMD ["--config", "/app/config.yaml", "--port", "4000", "--host", "0.0.0.0"]
